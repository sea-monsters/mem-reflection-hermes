# Session memory (local AI assistant state)
# NOTE: memory/ is a package dir, so we use !negation to track it.
# The pattern below only ignores files *inside* the memory dir, not the dir itself
# when it's tracked via explicit add.
memory/

# Package dirs (tracked) — negate any blanket ignores
!/core/
!/reflection/
!/memory/
!/runtime/
!/web/

# Local review artifacts (not for git)
docs/review/
